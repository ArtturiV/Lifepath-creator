@page "/"
@inject IJSRuntime JS

<PageTitle>Lifepath</PageTitle>

<div class="lifepath">
    @if (run is null)
    {
        <h1>Lifepath</h1>
        <LifepathPicker OnLoaded="Start" />
    }
    else
    {
        <button class="link" @onclick="ChooseAnother">&larr; Choose another lifepath</button>
        <h1>@run.Definition.Title</h1>

        @foreach (var step in run.Steps)
        {
            <PastCard Step="step" />
        }

        <div @ref="activeCardElement">
            <ActiveCard @key="run.Steps.Count" Run="run" OnAdvanced="HandleAdvanced" />
        </div>

        @if (run.IsFinished)
        {
            <Summary Run="run" />
            <button @onclick="StartOver">Start over</button>
            <button @onclick="ChooseAnother">Choose another lifepath</button>
        }
    }
</div>

@code {
    private LifepathRun? run;
    private ElementReference activeCardElement;
    private bool scrollPending;

    private void Start(LifepathDefinition definition) => run = new LifepathRun(definition);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (scrollPending)
        {
            scrollPending = false;
            await JS.InvokeVoidAsync("lifepath.scrollIntoView", activeCardElement);
        }
    }

    private void HandleAdvanced() => scrollPending = true;

    private void StartOver() => run = new LifepathRun(run!.Definition);

    private void ChooseAnother() => run = null;
}