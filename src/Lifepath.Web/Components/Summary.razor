@inject IJSRuntime JS

<section class="card summary">
    <h2>Summary</h2>

    @foreach (var section in summary.Sections)
    {
        <h3>@section.Heading</h3>
        <dl>
            @foreach (var entry in section.Entries)
            {
                <dt>@entry.Label</dt>
                <dd>@entry.Value</dd>
            }
        </dl>
    }

    <p><strong>Ending:</strong> @summary.Ending</p>

    <button @onclick="CopyToClipboard">@copyLabel</button>
</section>

@code {
    [Parameter, EditorRequired]
    public LifepathRun Run { get; set; } = default!;

    private LifepathSummary summary = default!;
    private string copyLabel = "Copy as text";

    protected override void OnParametersSet() => summary = LifepathSummary.From(Run);

    private async Task CopyToClipboard()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", summary.ToText());
            copyLabel = "Copied!";
        }
        catch (JSException)
        {
            copyLabel = "Could not copy";
        }
    }
}